export component TestCase inherits Window {
    TouchArea { mouse-cursor: not-allowed; }
    VerticalLayout {
        st := StyledText {

            text: @markdown("Hello **World**: \{"_abc_"} *\{@markdown("<u>xyz</u>")}*");
            default-color: red;
        }

        st_link := StyledText {
            text: @markdown("Click [this link](https://slint.dev)");
            link-clicked(url) => {
                clicked_link_url = url;
            }
            link-pointer-event(event) => {
                link_pointer_events += self.hovered-link
                    + (event.button == PointerEventButton.left ? " left" : event.button == PointerEventButton.middle ? " middle" : event.button == PointerEventButton.right ? " right" : " other")
                    + (event.kind == PointerEventKind.down ? " down" : event.kind == PointerEventKind.up ? " up" : " other")
                    + (event.modifiers.control ? " control" : "") + ";";
            }
        }
    }

    out property <bool> test: true;
    in-out property <string> clicked_link_url: "";
    in-out property <string> link_pointer_events: "";
    out property <string> hovered_link: st_link.hovered-link;
}

/*
```rust
use slint::{platform::Key, platform::PointerEventButton, platform::WindowEvent, LogicalPosition};
use slint::private_unstable_api::re_exports::{BuiltInMouseCursor, MouseCursorInner};

let instance = TestCase::new().unwrap();
assert!(instance.get_test());

// Not over a link: default cursor
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(5.0, 5.0) });
assert_eq!(slint_testing::access_testing_window(instance.window(), |window| window.mouse_cursor()), MouseCursorInner::BuiltIn(BuiltInMouseCursor::Default));

// Over the link: pointer cursor
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(30.0, 300.0) });
assert_eq!(slint_testing::access_testing_window(instance.window(), |window| window.mouse_cursor()), MouseCursorInner::BuiltIn(BuiltInMouseCursor::Pointer));
assert_eq!(instance.get_hovered_link(), "https://slint.dev");

// Move away from the link: back to default
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(5.0, 5.0) });
assert_eq!(slint_testing::access_testing_window(instance.window(), |window| window.mouse_cursor()), MouseCursorInner::BuiltIn(BuiltInMouseCursor::Default));
assert_eq!(instance.get_hovered_link(), "");

assert_eq!(instance.get_clicked_link_url(), "");

// Click on the link
slint_testing::send_mouse_click(&instance, 30.0, 300.0);
assert_eq!(instance.get_clicked_link_url(), "https://slint.dev");
assert_eq!(instance.get_link_pointer_events(), "https://slint.dev left down;https://slint.dev left up;");

// A middle and a right press on the link report their button, and click nothing.
instance.set_clicked_link_url("".into());
for button in [PointerEventButton::Middle, PointerEventButton::Right] {
    instance.set_link_pointer_events("".into());
    let position = LogicalPosition::new(30.0, 300.0);
    instance.window().dispatch_event(WindowEvent::PointerPressed { position, button });
    instance.window().dispatch_event(WindowEvent::PointerReleased { position, button });
    let name = if button == PointerEventButton::Middle { "middle" } else { "right" };
    assert_eq!(instance.get_link_pointer_events(), format!("https://slint.dev {name} down;https://slint.dev {name} up;"));
    assert_eq!(instance.get_clicked_link_url(), "");
}

// A click with Control held reports the modifier, and still clicks the link.
instance.set_link_pointer_events("".into());
instance.window().dispatch_event(WindowEvent::KeyPressed { text: Key::Control.into() });
slint_testing::send_mouse_click(&instance, 30.0, 300.0);
instance.window().dispatch_event(WindowEvent::KeyReleased { text: Key::Control.into() });
assert_eq!(instance.get_link_pointer_events(), "https://slint.dev left down control;https://slint.dev left up control;");
assert_eq!(instance.get_clicked_link_url(), "https://slint.dev");

// Not over a link: no event.
instance.set_link_pointer_events("".into());
slint_testing::send_mouse_click(&instance, 5.0, 5.0);
assert_eq!(instance.get_link_pointer_events(), "");
```

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert(instance.get_test());

assert_eq(instance.get_clicked_link_url(), "");
slint_testing::send_mouse_click(&instance, 30., 300.);
assert_eq(instance.get_clicked_link_url(), "https://slint.dev");
assert_eq(instance.get_link_pointer_events(), "https://slint.dev left down;https://slint.dev left up;");
```
*/
