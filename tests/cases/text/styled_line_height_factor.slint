export component TestCase inherits Window {
    width: 500phx;
    height: 500phx;
    default-font-size: 10px;

    VerticalLayout {
        alignment: start;

        plain := StyledText {
            text: @markdown("One");
        }

        spaced := StyledText {
            text: @markdown("One");
            line-height-factor: 2;
        }
    }

    out property <bool> test: spaced.height > plain.height * 1.5;
}
